<Window x:Class="DenonTrayApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Denon Volume"
        Width="220"
        Height="310"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="Window_Deactivated"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        KeyDown="Window_KeyDown">
    <Border Background="#1F1F23"
            BorderBrush="#3A3A3E"
            BorderThickness="1"
            CornerRadius="14"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12"
                              ShadowDepth="2"
                              Opacity="0.45"
                              Color="Black"/>
        </Border.Effect>

        <Grid Margin="12,10,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtVolume"
                       Grid.Row="0"
                       Grid.Column="0"
                       Text="--"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Width="80"
                       TextAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="TxtBrightness"
                       Grid.Row="0"
                       Grid.Column="1"
                       Text="--"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Width="80"
                       TextAlignment="Center"
                       Margin="0,0,0,8"/>

            <Slider x:Name="VolSlider"
                    Grid.Row="1"
                    Grid.Column="0"
                    Orientation="Vertical"
                    Minimum="0"
                    Maximum="80"
                    TickFrequency="0.5"
                    IsSnapToTickEnabled="True"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    MinWidth="40"
                    ValueChanged="VolSlider_ValueChanged"
                    PreviewMouseLeftButtonDown="VolSlider_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="VolSlider_PreviewMouseLeftButtonUp"
                    PreviewMouseWheel="VolSlider_PreviewMouseWheel"/>

            <Slider x:Name="BrightnessSlider"
                    Grid.Row="1"
                    Grid.Column="1"
                    Orientation="Vertical"
                    Minimum="0"
                    Maximum="100"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    MinWidth="40"
                    ValueChanged="BrightnessSlider_ValueChanged"
                    PreviewMouseLeftButtonDown="BrightnessSlider_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="BrightnessSlider_PreviewMouseLeftButtonUp"
                    PreviewMouseWheel="BrightnessSlider_PreviewMouseWheel"/>

            <TextBlock x:Name="TxtStatus"
                       Grid.Row="2"
                       Grid.Column="0"
                       Text="Denon"
                       Foreground="#9AA0A6"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       Cursor="Hand"
                       TextDecorations="Underline"
                       Margin="0,8,0,0"
                       MouseLeftButtonUp="TxtStatus_MouseLeftButtonUp"/>

            <ComboBox x:Name="CmbSoundMode"
                      Grid.Row="3"
                      Grid.Column="0"
                      Width="84"
                      MinWidth="80"
                      HorizontalAlignment="Center"
                      Margin="0,8,0,6"
                      FontSize="12"
                      Padding="6,4,6,4"
                      HorizontalContentAlignment="Left"
                      SelectionChanged="CmbSoundMode_SelectionChanged">
                <ComboBoxItem>Stereo</ComboBoxItem>
                <ComboBoxItem>Dolby Surround</ComboBoxItem>
                <ComboBoxItem>DTS Neural:X</ComboBoxItem>
                <ComboBoxItem>Multi Ch Stereo</ComboBoxItem>
            </ComboBox>
        </Grid>
    </Border>
</Window>
